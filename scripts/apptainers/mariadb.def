Bootstrap: localimage
From: /tmp/ubuntu-fakeroot.sif

%labels
    Maintainer "Squirrel"

%environment
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive
    export CC=/home/Squirrel/AFLplusplus/afl-cc
    export CXX=/home/Squirrel/AFLplusplus/afl-c++

%files
    # Copies local build context to the temp location
    # . /tmp/squirrel_context

%post
    # -----------------------------------------------------------------
    # Common environment
    # -----------------------------------------------------------------
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive

    FAKEROOTDONTTRYCHOWN=1 fakeroot bash -c '
      # -----------------------------------------------------------------
      # Install extra packages for MariaDB build
      # -----------------------------------------------------------------
      apt-get update && \
      apt-get -o Acquire::Retries=5 -y --no-install-recommends \
        libmysqlclient-dev \
        apt-transport-https \
        software-properties-common && \
      rm -rf /var/lib/apt/lists/*
    '

    # # -----------------------------------------------------------------
    # # Create a non‑root user (mirrors the Dockerfile)
    # # -----------------------------------------------------------------
    # groupadd dobigthing && \
    # useradd -l -K UMASK=0000 -d /home -g dobigthing dobigthing && \
    # mkdir -p /home && chown dobigthing:dobigthing /home && \
    # echo "dobigthing:dobigthing" | chpasswd && \
    # usermod -a -G sudo dobigthing && \
    # chmod +w /etc/sudoers && \
    # echo "%dobigthing   ALL=(ALL:ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    # chmod -w /etc/sudoers

    # -----------------------------------------------------------------
    # Build Squirrel
    # -----------------------------------------------------------------
    mkdir -p /models

    git config --global http.version HTTP/1.1
    git config --global submodule.fetchJobs 1
        
    # Build Squirrel context (old is the original Squirrel repo, new is the one with our changes)
    if [ "$USE_OLD_SQUIRREL" = "1" ]; then
        git clone --depth=1 https://github.com/Dobigthing666/Squirrel.git /home/Squirrel
    else
        git clone --depth=1 https://github.com/syurima/Squirrel.git /home/Squirrel
    fi

    cd /home/Squirrel
    for attempt in 1 2 3; do
        git submodule update --init --recursive --depth 1 --jobs 1 && break
    done

    # Compile Squirrel, AFLplusplus, and llama.cpp
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DSQLITE=ON
    cmake --build build -j

    cd AFLplusplus && LLVM_CONFIG=llvm-config-21 make -j20
    cd ../llama.cpp && cmake -B build && cmake --build build --config Release

    # -----------------------------------------------------------------
    # Build MariaDB
    # -----------------------------------------------------------------
    # Clone MariaDB source
    cd /home
    git clone --depth=1 https://github.com/MariaDB/server.git mariadb

    # Build MariaDB with the AFL compilers
    mkdir -p bld && cd bld
    CC=/home/Squirrel/AFLplusplus/afl-clang-lto \
    CXX=/home/Squirrel/AFLplusplus/afl-clang-lto++ \
    RANLIB=llvm-ranlib AR=llvm-ar AS=llvm-as \
    cmake ../mariadb && \
    make -j20 && \
    cmake --install . --prefix /usr/local/mysql/

    # # Ensure the non‑root user can own the installation
    # sudo chown -R dobigthing:dobigthing /usr/local/mysql/

    # Initialise the data directory
    cd /usr/local/mysql && \
    scripts/mysql_install_db

    # ------------------------------------------------------------------
    # Download LLM Model
    # ------------------------------------------------------------------
    cd /home/Squirrel/srcs/llm_fixer/models
    wget -O /models/qwen2.5-coder-1.5b-instruct-q4_0.gguf \
        "https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_0.gguf"


    # -----------------------------------------------------------------
    # Determine AFL map size
    # -----------------------------------------------------------------
    # Run a short instance to capture the map size, store it for the entrypoint
    AFL_DEBUG=1 __AFL_SHM_ID=1234 /usr/local/mysql/bin/mariadbd 2>&1 \
        | tail -n 1 | cut -d"," -f8 | cut -d" " -f3 > /tmp/mapsize

    # Clean up apt cache to keep the image small
    rm -rf /var/lib/apt/lists/*

%runscript
    cd /home/Squirrel/scripts/utils
    # Determine number of workers from the SLURM environment (if present)
    if [ -n "$AFL_WORKERS" ]; then
        WORKERS=$AFL_WORKERS
    else
        # Default to 1 (no extra workers) when not running under Slurm.
        WORKERS=1
    fi

    export AFL_MAP_SIZE=$(cat /tmp/mapsize)
    exec python3 run.py mariadb ../../data/fuzz_root/mysql_input/ --workers $WORKERS"$@"