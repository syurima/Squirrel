Bootstrap: localimage
From: /tmp/ubuntu-fakeroot.sif

%labels
    Maintainer "Squirrel-MariaDB"

%environment
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive
    export CC=/home/Squirrel/AFLplusplus/afl-clang-fast
    export CXX=/home/Squirrel/AFLplusplus/afl-clang-fast++

%files
    # (no changes needed)

%post
    # -----------------------------------------------------------------
    # Common environment
    # -----------------------------------------------------------------
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive

    # -----------------------------------------------------------------
    # Build Squirrel
    # -----------------------------------------------------------------
    mkdir -p /models
    git config --global http.version HTTP/1.1
    git config --global submodule.fetchJobs 1
    if [ "$USE_OLD_SQUIRREL" = "1" ]; then
        git clone --depth=1 https://github.com/Dobigthing666/Squirrel.git /home/Squirrel
    else
        git clone --depth=1 https://github.com/syurima/Squirrel.git /home/Squirrel
    fi

    cd /home/Squirrel
    for attempt in 1 2 3; do
        git submodule update --init --recursive --depth 1 --jobs 1 && break
    done

    # Compile Squirrel, AFLplusplus, and llama.cpp
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DSQLITE=ON
    cmake --build build -j
    cd AFLplusplus && LLVM_CONFIG=llvm-config-14 make -j20
    cd ../llama.cpp && cmake -B build && cmake --build build --config Release

    # -----------------------------------------------------------------
    # Build MariaDB with the AFL compilers
    # -----------------------------------------------------------------
    cd /home
    git clone --depth=1 https://github.com/MariaDB/server.git mariadb

    mkdir -p bld && cd bld
    CC=/home/Squirrel/AFLplusplus/afl-clang-fast \
    CXX=/home/Squirrel/AFLplusplus/afl-clang-fast++ \
    export CXXFLAGS="-std=c++17 $CXXFLAGS"
    RANLIB=llvm-ranlib AR=llvm-ar AS=llvm-as \
    cmake ../mariadb/ && \
    make -j20 && \
    cmake --install . --prefix /usr/local/mysql/

    # Initialise the data directory
    cd /usr/local/mysql && \
    scripts/mysql_install_db

    # -----------------------------------------------------------------
    # **Capture AFL map size now (build‑time)**
    # -----------------------------------------------------------------
    # The command prints a line that contains “… map size <N> …”.
    # We extract the numeric field and store it in a permanent file.
    AFL_DEBUG=1 __AFL_SHM_ID=1234 /usr/local/mysql/bin/mariadbd 2>&1 \
        | tail -n 1 | cut -d',' -f8 | cut -d' ' -f3 > /etc/afl_map_size

    # Optional sanity‑check (helps debugging if the file ends up empty)
    if [ ! -s /etc/afl_map_size ]; then
        echo "WARNING: AFL map size could not be detected during build."
    fi

    # -----------------------------------------------------------------
    # Download LLM model (unchanged)
    # -----------------------------------------------------------------
    cd /home/Squirrel/srcs/llm_fixer/models
    wget -O /models/qwen2.5-coder-1.5b-instruct-q4_0.gguf \
        "https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_0.gguf"

    # Clean up apt cache
    rm -rf /var/lib/apt/lists/*

%runscript
    # -----------------------------------------------------------------
    # Load the map size that was saved at build time
    # -----------------------------------------------------------------
    if [ -f /etc/afl_map_size ] && grep -qE '^[0-9]+$' /etc/afl_map_size; then
        export AFL_MAP_SIZE=$(cat /etc/afl_map_size)
    else
        # Fallback to a safe default if the file is missing or malformed
        echo "WARNING: Using default AFL_MAP_SIZE=65536"
        export AFL_MAP_SIZE=65536
    fi

    cd /home/Squirrel/scripts/utils

    # Determine number of workers from the SLURM environment (if present)
    if [ -n "$AFL_WORKERS" ]; then
        WORKERS=$AFL_WORKERS
    else
        WORKERS=1
    fi

    exec python3 run.py mariadb ../../data/fuzz_root/mysql_input/ --workers $WORKERS"$@"