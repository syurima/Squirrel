Bootstrap: docker
From: ubuntu:22.04

%labels
    Maintainer "Squirrel"

%environment
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive
    export CC=/home/Squirrel/AFLplusplus/afl-cc
    export CXX=/home/Squirrel/AFLplusplus/afl-c++

%files
    # Copies local build context to the temp location
    . /tmp/squirrel_context

%post
    # export USE_LLM=1
    # export DEBIAN_FRONTEND=noninteractive
    
    # Apptainer equivalent of ARG
    USE_REMOTE=0 
    CFLAGS="-DSQLITE_MAX_LENGTH=128000000 -DSQLITE_MAX_SQL_LENGTH=128000000 -DSQLITE_MAX_MEMORY=25000000 -DSQLITE_PRINTF_PRECISION_LIMIT=1048576 -DSQLITE_DEBUG=1 -DSQLITE_MAX_PAGE_COUNT=16384"

    # Common config & package installation
    apt-get -o Acquire::Retries=5 update
    apt-get -o Acquire::Retries=5 -y install make cmake build-essential vim sudo git tcl8.6 tcl8.6-tdbc-sqlite3 \
        clang ninja-build pkg-config clang-format \
        libpq-dev libyaml-cpp-dev lld llvm python3-fire curl wget

    # Ensure /home and model directories exist
    mkdir -p /home
    mkdir -p /models

    # Build Squirrel context
    if [ "$USE_REMOTE" = "1" ]; then
        git config --global http.version HTTP/1.1
        git config --global submodule.fetchJobs 1
        git clone --depth=1 https://github.com/s3team/Squirrel.git /home/Squirrel
        cd /home/Squirrel
        for attempt in 1 2 3; do
            git submodule update --init --recursive --depth 1 --jobs 1 && break
        done
    else
        mkdir -p /home/Squirrel
        cp -a /tmp/squirrel_context/. /home/Squirrel/
        rm -rf /home/Squirrel/AFLplusplus
        cd /home/Squirrel
        git submodule update --init --recursive --depth 1 --jobs 1
    fi

    # Compile Squirrel, AFLplusplus, and llama.cpp
    cd /home/Squirrel
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DSQLITE=ON
    cmake --build build -j
    
    cd AFLplusplus/
    LLVM_CONFIG=llvm-config-14 make -j20
    
    cd ../llama.cpp/
    cmake -B build
    cmake --build build --config Release

    # Download LLM Model
    cd /home/Squirrel/srcs/llm_fixer/models
    wget -O /models/qwen2.5-coder-1.5b-instruct-q4_0.gguf \
        "https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_0.gguf"

    # Clone and configure SQLite
    cd /home
    git clone https://github.com/sqlite/sqlite sqlite3/
    cd sqlite3
    mkdir bld
    cd bld

    # Build SQLite using AFL compilers
    # export CC=/home/Squirrel/AFLplusplus/afl-cc
    # export CXX=/home/Squirrel/AFLplusplus/afl-c++
    
    ../configure
    make -j
    make sqlite3.c

    $CC $CFLAGS -I. -c /home/sqlite3/test/ossfuzz.c -o /home/sqlite3/test/ossfuzz.o
    $CC $CFLAGS -I. -c /home/sqlite3/test/ossshell.c -o /home/sqlite3/test/ossshell.o

    $CXX $CXXFLAGS \
        /home/sqlite3/test/ossfuzz.o /home/sqlite3/test/ossshell.o -o /home/ossfuzz \
        ./sqlite3.o -ldl -pthread

    # Clean up temp build context to save image space
    rm -rf /tmp/squirrel_context

%runscript
    cd /home/Squirrel/scripts/utils
    exec python3 run.py sqlite ../../data/fuzz_root/input "$@"