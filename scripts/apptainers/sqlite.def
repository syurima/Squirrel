Bootstrap: localimage
From: /tmp/ubuntu-fakeroot.sif

%labels
    Maintainer "Squirrel"

%environment
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive
    export CC=/home/Squirrel/AFLplusplus/afl-cc
    export CXX=/home/Squirrel/AFLplusplus/afl-c++

%files
    # Copies local build context to the temp location
    # . /tmp/squirrel_context

%post
    export USE_LLM=1
    export DEBIAN_FRONTEND=noninteractive
    
    export CFLAGS="-DSQLITE_MAX_LENGTH=128000000 -DSQLITE_MAX_SQL_LENGTH=128000000 -DSQLITE_MAX_MEMORY=25000000 -DSQLITE_PRINTF_PRECISION_LIMIT=1048576 -DSQLITE_DEBUG=1 -DSQLITE_MAX_PAGE_COUNT=16384"

    # import extra packages for SQLite build
    FAKEROOTDONTTRYCHOWN=1 fakeroot bash -c '
      # -----------------------------------------------------------------
      # Install extra packages for SQLite build
      # -----------------------------------------------------------------
      apt-get update && \
      apt-get -o Acquire::Retries=5 -y \
        tcl8.6 tcl8.6-tdbc-sqlite3
      rm -rf /var/lib/apt/lists/*
    '

    # Ensure /home and model directories exist
    mkdir -p /home
    mkdir -p /models

    git config --global http.version HTTP/1.1
    git config --global submodule.fetchJobs 1
        
    # Build Squirrel context (old is the original Squirrel repo, new is the one with our changes)
    if [ "$USE_OLD_SQUIRREL" = "1" ]; then
        git clone --depth=1 https://github.com/s3team/Squirrel.git /home/Squirrel
    else
        git clone --depth=1 https://github.com/syurima/Squirrel.git /home/Squirrel
    fi
    cd /home/Squirrel
    for attempt in 1 2 3; do
        git submodule update --init --recursive --depth 1 --jobs 1 && break
    done

    # Compile Squirrel, AFLplusplus, and llama.cpp
    cd /home/Squirrel
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DSQLITE=ON
    cmake --build build -j
    
    cd AFLplusplus/
    LLVM_CONFIG=llvm-config-21 make -j20
    
    cd ../llama.cpp/
    cmake -B build
    cmake --build build --config Release

    # Clone and configure SQLite
    cd /home
    git clone https://github.com/sqlite/sqlite sqlite3/
    cd sqlite3
    mkdir bld
    cd bld

    # Build SQLite using AFL compilers
    export CC=/home/Squirrel/AFLplusplus/afl-clang-lto
    export CXX=/home/Squirrel/AFLplusplus/afl-clang-lto++
    export RANLIB=llvm-ranlib
    export AR=llvm-ar
    export AS=llvm-as

    ../configure
    make -j
    make sqlite3.c

    $CC $CFLAGS -I. -c /home/sqlite3/test/ossfuzz.c -o /home/sqlite3/test/ossfuzz.o
    $CC $CFLAGS -I. -c /home/sqlite3/test/ossshell.c -o /home/sqlite3/test/ossshell.o

    $CXX $CXXFLAGS \
        /home/sqlite3/test/ossfuzz.o /home/sqlite3/test/ossshell.o -o /home/ossfuzz \
        ./sqlite3.o -ldl -pthread

     # Download LLM Model
    cd /home/Squirrel/srcs/llm_fixer/models
    wget -O /models/qwen2.5-coder-1.5b-instruct-q4_0.gguf \
        "https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_0.gguf"

    # Clean up temp build context to save image space
    rm -rf /tmp/squirrel_context
    rm -rf /var/lib/apt/lists/*

%runscript
    cd /home/Squirrel/scripts/utils
    # Determine number of workers from the SLURM environment (if present)
    if [ -n "$AFL_WORKERS" ]; then
        WORKERS=$AFL_WORKERS
    else
        # Default to 1 (no extra workers) when not running under Slurm.
        WORKERS=1
    fi
    # Pass the workers count as a named argument to the Python script.
    exec python3 run.py sqlite ../../data/fuzz_root/input --workers $WORKERS "$@"